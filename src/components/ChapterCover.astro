---
interface Props {
  slug: string;
  lang: string;
  chapterLabel: string; // ex: "Capítulo 1" já traduzido no idioma da leitura
  openLabel: string;
}

const { slug, lang, chapterLabel, openLabel } = Astro.props;

// Título estilizado de cada sala, traduzido por idioma de leitura.
const TITLES: Record<string, Record<string, string>> = {
  neve: {
    pt: 'Neve', en: 'Snow', es: 'Nieve', fr: 'Neige',
    ja: '雪', zh: '雪', uk: 'Сніг', ru: 'Снег',
  },
  artista: {
    pt: 'Cores', en: 'Colors', es: 'Colores', fr: 'Couleurs',
    ja: '色彩', zh: '色彩', uk: 'Кольори', ru: 'Цвета',
  },
  nevoa: {
    pt: 'Névoa', en: 'Mist', es: 'Niebla', fr: 'Brume',
    ja: '霧', zh: '迷雾', uk: 'Туман', ru: 'Туман',
  },
  matcha: {
    pt: 'Matcha', en: 'Matcha', es: 'Matcha', fr: 'Matcha',
    ja: '抹茶', zh: '抹茶', uk: 'Матча', ru: 'Матча',
  },
  cafeteria: {
    pt: 'Café', en: 'Coffee', es: 'Café', fr: 'Café',
    ja: 'コーヒー', zh: '咖啡', uk: 'Кава', ru: 'Кофе',
  },
  'minha-sala': {
    pt: 'Minha Sala', en: 'My Room', es: 'Mi Sala', fr: 'Ma Salle',
    ja: '私の部屋', zh: '我的房间', uk: 'Моя кімната', ru: 'Моя комната',
  },
  introducao: {
    pt: 'Introdução', en: 'Introduction', es: 'Introducción', fr: 'Introduction',
    ja: '序章', zh: '序言', uk: 'Вступ', ru: 'Введение',
  },
};

// Configuração de identidade visual por sala: fonte, legenda cultural e paleta.
// O título em si vem de TITLES (acima), traduzido por idioma.
const COVERS: Record<
  string,
  { subtitle?: string; font: string; palette: { bg: string; ink: string; accent: string } }
> = {
  neve: {
    subtitle: 'Ландшафт памяти',
    font: 'neve',
    palette: { bg: '#f0f3f6', ink: '#2b3a4a', accent: '#5c768d' },
  },
  artista: {
    font: 'artista',
    palette: { bg: '#fbf3ec', ink: '#4a3b42', accent: '#c1607a' },
  },
  nevoa: {
    subtitle: '霧',
    font: 'nevoa',
    palette: { bg: '#eef1f5', ink: '#3a4250', accent: '#7d93b8' },
  },
  matcha: {
    font: 'matcha',
    palette: { bg: '#f2ede0', ink: '#2b3a27', accent: '#6f8f5c' },
  },
  cafeteria: {
    font: 'cafeteria',
    palette: { bg: '#efe6d3', ink: '#2c2620', accent: '#a8402c' },
  },
  'minha-sala': {
    font: 'default',
    palette: { bg: '#efe6d3', ink: '#38352f', accent: '#7d7871' },
  },
  introducao: {
    font: 'default',
    palette: { bg: '#e9e7e2', ink: '#2b2723', accent: '#8b8b86' },
  },
};

const cover = COVERS[slug] ?? COVERS.introducao;
const coverTitle = TITLES[slug]?.[lang] ?? TITLES.introducao[lang] ?? TITLES.introducao.pt;
// Para a sala da névoa, o kanji "霧" já serve de título em japonês — não repete como subtítulo.
const showKanjiSubtitle = cover.subtitle === '霧' && lang !== 'ja';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Marck+Script&family=Shippori+Mincho:wght@400;600&family=ZCOOL+XiaoWei&family=Patrick+Hand&family=Playfair+Display:ital@0;1&display=swap"
  rel="stylesheet"
/>

<div
  class="chapter-cover"
  id="chapter-cover"
  data-variant={cover.font}
  style={`--cover-bg: ${cover.palette.bg}; --cover-ink: ${cover.palette.ink}; --cover-accent: ${cover.palette.accent};`}
>
  <div class="cover-art" aria-hidden="true">
    {cover.font === 'neve' && (
      <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07" />
        <circle cx="12" cy="12" r="3" fill="currentColor" fill-opacity="0.15" />
        <path d="M12 7l2-2M12 7l-2-2M12 17l2 2M12 17l-2 2M7 12l-2 2M7 12l-2-2M17 12l2 2M17 12l2-2" />
      </svg>
    )}
    {cover.font === 'artista' && (
      <div class="watercolor-blob"></div>
    )}
    {cover.font === 'nevoa' && (
      <svg width="220" height="90" viewBox="0 0 220 90" fill="none">
        <path d="M0 70 L35 40 L60 58 L95 25 L130 55 L165 35 L220 68 L220 90 L0 90 Z" fill="var(--cover-ink)" opacity="0.16" />
        <path d="M0 78 L45 55 L80 68 L120 45 L160 65 L220 78 L220 90 L0 90 Z" fill="var(--cover-ink)" opacity="0.22" />
        <circle cx="40" cy="18" r="1.4" fill="var(--cover-ink)" opacity="0.5" />
        <circle cx="90" cy="10" r="1" fill="var(--cover-ink)" opacity="0.4" />
        <circle cx="150" cy="16" r="1.2" fill="var(--cover-ink)" opacity="0.45" />
        <circle cx="180" cy="8" r="1" fill="var(--cover-ink)" opacity="0.35" />
      </svg>
    )}
    {cover.font === 'matcha' && (
      <svg width="120" height="90" viewBox="0 0 120 90" fill="none">
        <path d="M30 55 Q60 75 90 55 L84 66 Q60 82 36 66 Z" fill="none" stroke="var(--cover-ink)" stroke-width="2.5" stroke-linecap="round" />
        <path d="M40 55 Q45 40 60 42 Q52 48 50 55 Z" fill="var(--cover-accent)" opacity="0.55" />
        <path d="M58 55 Q64 38 78 44 Q66 48 63 55 Z" fill="var(--cover-accent)" opacity="0.4" />
      </svg>
    )}
    {cover.font === 'cafeteria' && (
      <svg width="160" height="80" viewBox="0 0 160 80" fill="none" stroke="var(--cover-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="10" y="10" width="34" height="60" rx="1" />
        <line x1="10" y1="30" x2="44" y2="30" />
        <line x1="10" y1="50" x2="44" y2="50" />
        <rect x="70" y="35" width="30" height="28" rx="2" />
        <line x1="76" y1="35" x2="76" y2="26" />
        <line x1="94" y1="35" x2="94" y2="26" />
        <circle cx="126" cy="30" r="9" fill="var(--cover-accent)" fill-opacity="0.5" stroke="none" />
      </svg>
    )}
    {(cover.font === 'default') && (
      <div class="ornament-line"></div>
    )}
  </div>

  <h1 class="cover-title">
    {cover.font === 'nevoa' && showKanjiSubtitle && <span class="cover-kanji">{cover.subtitle}</span>}
    {coverTitle}
  </h1>
  {cover.font !== 'nevoa' && cover.subtitle && <span class="cover-subtitle">{cover.subtitle}</span>}
  <span class="cover-chapter-label">{chapterLabel}</span>

  <button class="cover-open" id="cover-open">{openLabel}</button>
</div>

<style>
  .chapter-cover {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--cover-bg);
    color: var(--cover-ink);
    text-align: center;
    padding: 2rem;
    transition: opacity 0.9s ease, visibility 0.9s ease;
  }
  .chapter-cover.cover-closing {
    opacity: 0;
    pointer-events: none;
  }

  .cover-art {
    margin-bottom: 0.5rem;
    color: var(--cover-ink);
  }

  .watercolor-blob {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    filter: blur(30px);
    opacity: 0.45;
    background: linear-gradient(120deg, #ec4899, #a855f7 45%, #38bdf8 90%);
  }

  .ornament-line {
    width: 50px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cover-accent), transparent);
    margin-bottom: 0.5rem;
  }

  .cover-eyebrow {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--cover-accent);
    opacity: 0.85;
  }

  .cover-title {
    font-size: clamp(2.6rem, 8vw, 4.5rem);
    margin: 0;
    line-height: 1.1;
    letter-spacing: 0.06em;
  }

  /* Fontes por sala */
  .chapter-cover[data-variant='neve'] .cover-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .chapter-cover[data-variant='artista'] .cover-title {
    font-family: 'Marck Script', cursive;
    font-size: clamp(3rem, 9vw, 5.5rem);
  }
  .chapter-cover[data-variant='nevoa'] .cover-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    letter-spacing: 0.2em;
  }
  .chapter-cover[data-variant='matcha'] .cover-title {
    font-family: 'ZCOOL XiaoWei', serif;
    font-weight: 400;
  }
  .chapter-cover[data-variant='cafeteria'] .cover-title {
    font-family: 'Patrick Hand', cursive;
  }
  .chapter-cover[data-variant='default'] .cover-title {
    font-family: 'Fraunces', 'Playfair Display', serif;
    font-weight: 400;
  }

  .cover-kanji {
    display: block;
    font-family: 'Shippori Mincho', serif;
    font-size: clamp(3rem, 10vw, 5rem);
    opacity: 0.85;
    margin-bottom: 0.2rem;
  }

  .cover-subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1rem;
    letter-spacing: 0.15em;
    opacity: 0.7;
  }

  .cover-chapter-label {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-top: 0.5rem;
  }

  .cover-open {
    margin-top: 2rem;
    background: transparent;
    border: 1px solid var(--cover-accent);
    color: var(--cover-ink);
    padding: 0.65rem 1.6rem;
    border-radius: 4px;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .cover-open:hover {
    background: color-mix(in srgb, var(--cover-accent) 15%, transparent);
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-cover {
      transition: none;
    }
  }
</style>

<script>
  function initCover() {
    const cover = document.getElementById('chapter-cover');
    const openBtn = document.getElementById('cover-open');
    const reader = document.querySelector('.book-wrap-container') as HTMLElement | null;

    function openCover() {
      if (!cover) return;
      cover.classList.add('cover-closing');
      window.setTimeout(() => {
        cover.style.display = 'none';
        reader?.classList.add('reader-visible');
      }, 900);
    }

    openBtn?.addEventListener('click', openCover);
    cover?.addEventListener('click', (e) => {
      if (e.target === cover) openCover();
    });
  }

  initCover();
</script>
