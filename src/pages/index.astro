---
import '../styles/global.css';
import LanguageDoor from '../components/LanguageDoor.astro';
import { languages } from '../i18n/config';

// Leve variação orgânica entre as portas (não é mais profundidade agressiva
// de perspectiva) — todas ficam legíveis, só com um toque sutil de ondulação.
const entries = Object.entries(languages);

function waveStyle(i: number) {
  const lift = i % 2 === 0 ? 0 : 16; // px — alterna leve subida/descida
  const scale = 1 - (i % 3) * 0.02; // variação mínima de tamanho, quase imperceptível
  return `transform: translateY(${lift}px) scale(${scale});`;
}

// Título "As Salas" traduzido — usa artigo quando natural no idioma.
const MAIN_TITLE: Record<string, string> = {
  pt: 'As Salas',
  en: 'The Rooms',
  es: 'Las Salas',
  fr: 'Les Salles',
  ja: '部屋',
  zh: '房间',
  uk: 'Кімнати',
  ru: 'Комнаты',
};
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>As Salas — uma prévia do livro</title>
    <meta
      name="description"
      content="Uma prévia do livro — leia os primeiros capítulos em 8 idiomas, num corredor de salas onde cada uma tem seu próprio clima."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="As Salas — uma prévia do livro" />
    <meta
      property="og:description"
      content="Leia os primeiros capítulos em 8 idiomas, num corredor de salas onde cada uma tem seu próprio clima."
    />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site ?? Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="As Salas — uma prévia do livro" />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site ?? Astro.url).toString()} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Serif+4:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Cinzel:wght@500;600&family=Montserrat:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="corridor-body">
    <main class="corridor">
      <div class="hallway" aria-hidden="true">
        <div class="wall wall-left"></div>
        <div class="wall wall-right"></div>
        <div class="floor"></div>
        <div class="vanishing-glow"></div>
        <div class="dust-mote dust-1"></div>
        <div class="dust-mote dust-2"></div>
        <div class="dust-mote dust-3"></div>
      </div>

      <div class="hero" aria-hidden="false">
        <div class="hero-art" aria-hidden="true">
          <!-- "O Mosaico do Corredor": traço ligne claire, silhueta de costas
               diante de uma porta, com cores de cada sala escapando ao redor. -->
          <svg viewBox="0 0 400 260" xmlns="http://www.w3.org/2000/svg">
            <!-- rajada de névoa (azul-acinzentado) -->
            <path d="M40 70 Q75 55 105 68 Q130 78 160 62" fill="none" stroke="#8fa9c4" stroke-width="2.5" stroke-linecap="round" opacity="0.55" />
            <path d="M30 88 Q60 76 95 86" fill="none" stroke="#8fa9c4" stroke-width="2" stroke-linecap="round" opacity="0.4" />

            <!-- flocos de neve (branco) -->
            <circle cx="185" cy="45" r="2.4" fill="#f4f7fa" opacity="0.8" />
            <circle cx="200" cy="60" r="1.6" fill="#f4f7fa" opacity="0.6" />
            <circle cx="170" cy="58" r="1.4" fill="#f4f7fa" opacity="0.55" />

            <!-- vapor + folha de matchá (verde) -->
            <path d="M300 95 Q292 78 302 62 Q294 78 306 90" fill="none" stroke="#7fae7a" stroke-width="2.2" stroke-linecap="round" opacity="0.6" />
            <ellipse cx="308" cy="96" rx="6" ry="3.2" fill="#7fae7a" opacity="0.5" transform="rotate(30 308 96)" />

            <!-- redemoinho aquarela (rosa/vermelho da artista) -->
            <path d="M330 130 Q346 118 344 100 Q356 116 342 128 Q356 132 344 144" fill="none" stroke="#c1607a" stroke-width="2.4" stroke-linecap="round" opacity="0.6" />

            <!-- página voando (linha clara) -->
            <rect x="60" y="115" width="20" height="26" rx="1.5" fill="none" stroke="#cfc6b8" stroke-width="1.4" opacity="0.55" transform="rotate(-18 70 128)" />

            <!-- ursinho roxo, quase escondido (easter egg) -->
            <circle cx="248" cy="150" r="3" fill="#9a7ab8" opacity="0.5" />

            <!-- porta central, traço fino uniforme -->
            <rect x="168" y="150" width="64" height="98" rx="3" fill="none" stroke="#cfc6b8" stroke-width="2" opacity="0.85" />
            <line x1="200" y1="150" x2="200" y2="248" stroke="#cfc6b8" stroke-width="1" opacity="0.35" />
            <circle cx="222" cy="200" r="2" fill="#cfc6b8" opacity="0.7" />

            <!-- silhueta de costas, diante da porta -->
            <path
              d="M188 248 L188 205 Q188 185 200 185 Q212 185 212 205 L212 248 Z"
              fill="#0b0a0d"
            />
            <circle cx="200" cy="176" r="9" fill="#0b0a0d" />
          </svg>
        </div>

        <h1 class="hero-title" id="hero-title">
          {Object.entries(languages).map(([code], i) => (
            <span class="hero-title-word" data-lang={code} style={i === 0 ? 'opacity:1;' : ''}>
              {MAIN_TITLE[code] ?? MAIN_TITLE.pt}
            </span>
          ))}
        </h1>
      </div>

      <p class="corridor-hint">
        Escolha uma porta · Choose a door · Elige una puerta · 扉を選んでください
      </p>

      <div class="doors-stage">
        {entries.map(([code, name], i) => (
          <div class="door-slot" style={waveStyle(i)}>
            <LanguageDoor code={code} label={name} href={`/${code}/`} number={String(i + 1).padStart(3, '0')} />
          </div>
        ))}
      </div>
    </main>

    <style>
      .corridor-body {
        min-height: 100vh;
        margin: 0;
        background: #0b0a0d;
        color: #cfc6b8;
        font-family: 'Source Serif 4', Georgia, serif;
        overflow-x: hidden;
      }

      .corridor {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
      }

      .hallway {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
      }

      .wall {
        position: absolute;
        top: 0;
        bottom: 30%;
        width: 60%;
        background: linear-gradient(180deg, #1c1915 0%, #0e0c0a 100%);
      }
      .wall-left {
        left: 0;
        clip-path: polygon(0 0, 100% 0, 46% 100%, 0 100%);
        background: linear-gradient(90deg, #201b15 0%, #0e0c0a 100%);
      }
      .wall-right {
        right: 0;
        clip-path: polygon(0 0, 100% 0, 100% 100%, 54% 100%);
        background: linear-gradient(270deg, #201b15 0%, #0e0c0a 100%);
      }
      .floor {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 42%;
        background:
          repeating-linear-gradient(
            180deg,
            rgba(0, 0, 0, 0.25) 0px,
            transparent 2px,
            transparent 40px
          ),
          linear-gradient(180deg, #141210 0%, #060505 100%);
        clip-path: polygon(30% 0, 70% 0, 100% 100%, 0 100%);
      }

      .vanishing-glow {
        position: absolute;
        left: 50%;
        top: 26%;
        width: 14vw;
        height: 14vw;
        max-width: 220px;
        max-height: 220px;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, rgba(201, 138, 82, 0.35) 0%, rgba(201, 138, 82, 0.08) 45%, transparent 75%);
        filter: blur(6px);
        animation: glow-breathe 8s ease-in-out infinite;
      }
      @keyframes glow-breathe {
        0%, 100% { opacity: 0.7; }
        50% { opacity: 1; }
      }

      .dust-mote {
        position: absolute;
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #9a9488;
        opacity: 0.4;
        filter: blur(0.5px);
      }
      .dust-1 { top: 45%; left: 48%; animation: float-dust 16s ease-in-out infinite; }
      .dust-2 { top: 55%; left: 53%; animation: float-dust 20s ease-in-out infinite 3s; }
      .dust-3 { top: 38%; left: 44%; animation: float-dust 24s ease-in-out infinite 6s; }
      @keyframes float-dust {
        0%, 100% { transform: translate(0, 0); opacity: 0.15; }
        50% { transform: translate(1vw, -3vh); opacity: 0.5; }
      }

      .hero {
        position: relative;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: clamp(1rem, 3vh, 2rem);
      }

      .hero-art {
        width: min(90vw, 420px);
        filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.5));
      }
      .hero-art svg {
        width: 100%;
        height: auto;
        display: block;
      }

      .hero-title {
        position: relative;
        font-family: 'Playfair Display', 'Cinzel', serif;
        font-weight: 600;
        font-size: clamp(2.2rem, 6vw, 3.6rem);
        letter-spacing: 0.04em;
        color: #f1e9d8;
        margin: 0;
        text-align: center;
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
        min-height: 1.3em;
        min-width: 8ch;
      }

      .hero-title-word {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 1.2s ease;
        white-space: nowrap;
      }

      .corridor-hint {
        position: relative;
        z-index: 10;
        font-style: italic;
        font-size: clamp(0.78rem, 1.3vw, 0.92rem);
        color: rgba(154, 148, 136, 0.85);
        text-align: center;
        letter-spacing: 0.01em;
        max-width: 40rem;
        margin: 0 0 clamp(1.5rem, 5vh, 3rem);
      }

      .doors-stage {
        position: relative;
        z-index: 5;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: flex-end;
        gap: clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
        max-width: 60rem;
        padding: 0 1rem;
      }

      .door-slot {
        transition: transform 0.3s;
      }

      @media (prefers-reduced-motion: reduce) {
        .vanishing-glow, .dust-mote { animation: none; }
        .hero-title-word { transition: none; }
      }
    </style>

    <script>
      // Se a pessoa já escolheu um idioma antes, pula direto pra ele.
      // Acessar com "?stay" força mostrar o corredor de novo (ex: link "Corredor" no cabeçalho).
      function redirectToRememberedLang() {
        const params = new URLSearchParams(window.location.search);
        if (params.has('stay')) return;
        try {
          const remembered = localStorage.getItem('preferred-lang');
          if (remembered) {
            window.location.replace(`/${remembered}/`);
          }
        } catch {
          // localStorage indisponível — mostra o corredor normalmente
        }
      }
      redirectToRememberedLang();

      function initTitleCycle() {
        const words = Array.from(document.querySelectorAll<HTMLElement>('.hero-title-word'));
        if (words.length < 2) return;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion) return;

        let current = 0;
        window.setInterval(() => {
          const next = (current + 1) % words.length;
          words[current].style.opacity = '0';
          words[next].style.opacity = '1';
          current = next;
        }, 3200);
      }
      initTitleCycle();
    </script>
  </body>
</html>
