---
import '../styles/global.css';
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Porta não encontrada</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;1,400&family=Source+Serif+4:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="not-found-body">
    <main class="not-found">
      <svg width="64" height="64" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="9" y="6" width="14" height="23" rx="2" fill="none" stroke="#c98a52" stroke-width="1.4" />
        <line x1="16" y1="6" x2="16" y2="29" stroke="#c98a52" stroke-width="0.6" opacity="0.4" />
        <circle cx="20" cy="18" r="1" fill="#c98a52" />
      </svg>
      <h1>Essa porta não existe</h1>
      <p>
        Talvez ela tenha se dissipado na névoa, ou talvez você tenha pegado um corredor errado.
        <br />
        This door doesn't exist — it may have dissolved into the mist, or you took a wrong turn.
      </p>
      <a href="/?stay" class="back-link">← Voltar ao corredor · Back to the corridor</a>
    </main>

    <style>
      .not-found-body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0b0a0d;
        color: #cfc6b8;
      }
      .not-found {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        text-align: center;
        padding: 2rem;
        max-width: 32rem;
      }
      .not-found h1 {
        font-family: 'Playfair Display', serif;
        font-style: italic;
        font-size: clamp(1.6rem, 5vw, 2.2rem);
        font-weight: 400;
        margin: 0;
        color: #f1e9d8;
      }
      .not-found p {
        font-family: 'Source Serif 4', Georgia, serif;
        font-size: 0.95rem;
        line-height: 1.7;
        color: #9a9488;
        margin: 0;
      }
      .back-link {
        margin-top: 0.5rem;
        font-family: 'Source Serif 4', Georgia, serif;
        font-size: 0.9rem;
        color: #c98a52;
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.3s;
      }
      .back-link:hover {
        border-color: #c98a52;
      }
    </style>
  </body>
</html>
