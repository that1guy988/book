---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, type Lang } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const allSalas = await getCollection('salas');
// Filtra pelo idioma atual e ordena pelo campo "order"
const salas = allSalas
  .filter((entry) => entry.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout lang={lang} title={t('rooms.title')}>
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl tracking-wide">{t('rooms.title')}</h1>
    <span id="rooms-progress" class="text-sm text-stone-400"></span>
  </div>
  <ul class="space-y-4" id="rooms-list">
    {salas.map((sala) => {
      const slug = sala.id.split('/')[0];
      return (
        <li>
          <a
            href={`/${lang}/salas/${slug}/`}
            class="room-link flex items-center justify-between gap-3 p-4 rounded transition-all"
            style={`--room-accent: ${sala.data.ambientColor};`}
            data-room-slug={slug}
          >
            <span class="text-lg">{sala.data.title}</span>
            <span class="room-visited-check text-stone-500 text-sm" hidden>✓</span>
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<style>
  .room-link {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-left: 3px solid color-mix(in srgb, var(--room-accent) 55%, transparent);
  }
  .room-link:hover {
    border-color: rgba(255, 255, 255, 0.2);
    border-left-color: var(--room-accent);
    background: rgba(255, 255, 255, 0.04);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--room-accent) 40%, transparent);
  }
  .room-link.visited {
    border-left-color: var(--room-accent);
  }
</style>

<script define:vars={{ visitedLabel: t('rooms.visited'), totalRooms: salas.length }}>
  try {
    const visited = new Set(JSON.parse(localStorage.getItem('visited-rooms') || '[]'));
    document.querySelectorAll('[data-room-slug]').forEach((el) => {
      const slug = el.getAttribute('data-room-slug');
      if (slug && visited.has(slug)) {
        const check = el.querySelector('.room-visited-check');
        check?.removeAttribute('hidden');
        el.classList.add('visited');
      }
    });
    const progressEl = document.getElementById('rooms-progress');
    if (progressEl) {
      // conta só as salas visitadas que existem nesta listagem
      const visibleSlugs = Array.from(document.querySelectorAll('[data-room-slug]')).map((el) =>
        el.getAttribute('data-room-slug')
      );
      const visitedCount = visibleSlugs.filter((s) => s && visited.has(s)).length;
      progressEl.textContent = `${visitedCount} / ${totalRooms} ${visitedLabel}`;
    }
  } catch {
    // localStorage indisponível — sem indicador de progresso
  }
</script>
