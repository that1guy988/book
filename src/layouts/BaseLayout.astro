---
import '../styles/global.css';
import { languages, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import AmbientBackground from '../components/AmbientBackground.astro';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  ambientColor?: string;
  ambientEffect?: 'fog' | 'steam' | 'dust' | 'embers' | 'snow' | 'none';
}

const DEFAULT_DESCRIPTION: Record<string, string> = {
  pt: 'Uma prévia do livro — leia os primeiros capítulos em 8 idiomas, num corredor de salas onde cada uma tem seu próprio clima.',
  en: 'A preview of the book — read the first chapters in 8 languages, through a corridor of rooms each with its own atmosphere.',
  es: 'Una vista previa del libro — lee los primeros capítulos en 8 idiomas, en un corredor de salas con su propia atmósfera.',
  fr: 'Un aperçu du livre — lisez les premiers chapitres en 8 langues, à travers un couloir de salles à l\'atmosphère propre.',
  ja: '本の試し読み — 8つの言語で、それぞれ独自の雰囲気を持つ部屋が並ぶ廊下を通って最初の章を読む。',
  zh: '本书试读 — 用8种语言阅读前几章，穿过一条走廊,每个房间都有自己的氛围。',
  uk: 'Попередній перегляд книги — прочитайте перші розділи 8 мовами, у коридорі кімнат із власною атмосферою.',
  ru: 'Предпросмотр книги — прочитайте первые главы на 8 языках, в коридоре комнат с собственной атмосферой.',
};

const { lang, title, description, ambientColor = '#7a2e2e', ambientEffect = 'none' } = Astro.props;
const t = useTranslations(lang);
const pageDescription = description ?? DEFAULT_DESCRIPTION[lang] ?? DEFAULT_DESCRIPTION.pt;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Source+Serif+4:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Marck+Script&family=Shippori+Mincho:wght@400;600&family=ZCOOL+XiaoWei&family=Patrick+Hand&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Cinzel:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-stone-950 text-stone-100 font-serif" style={`--room-accent: ${ambientColor};`}>
    <AmbientBackground color={ambientColor} effect={ambientEffect} />
    <header class="relative z-10 border-b border-stone-800 room-header">
      <nav class="max-w-3xl mx-auto flex items-center justify-between px-6 py-4">
        <a href={`/${lang}/`} class="text-lg tracking-wide room-home-link">{t('nav.home')}</a>
        <div class="flex items-center gap-4">
          <a href="/?stay" class="text-sm text-stone-400 hover:text-stone-100 transition-colors" title="Ver o corredor de portas">
            🚪
          </a>
          <a href={`/${lang}/salas/`} class="text-sm text-stone-400 hover:text-stone-100 transition-colors room-nav-link">
            {t('nav.rooms')}
          </a>
          <select
            id="lang-switch"
            class="bg-stone-900 border border-stone-700 rounded px-2 py-1 text-sm"
            data-current={lang}
          >
            {Object.entries(languages).map(([code, name]) => (
              <option value={code} selected={code === lang}>{name}</option>
            ))}
          </select>
        </div>
      </nav>
    </header>
    <main class="relative z-10 max-w-3xl mx-auto px-6 py-12">
      <slot />
    </main>

    <style>
      .room-header {
        border-bottom-color: color-mix(in srgb, var(--room-accent) 35%, rgb(41 37 36));
        transition: border-color 0.6s ease;
      }
      .room-home-link {
        transition: color 0.3s ease;
      }
      .room-home-link:hover {
        color: var(--room-accent);
      }
      .room-nav-link:hover {
        color: var(--room-accent) !important;
      }
    </style>

    <script>
      const select = document.getElementById('lang-switch') as HTMLSelectElement;
      select?.addEventListener('change', () => {
        const current = select.dataset.current;
        const target = select.value;
        // Troca o idioma mantendo a página atual (ex: /pt/salas/nevoa -> /en/salas/nevoa)
        const path = window.location.pathname.replace(`/${current}/`, `/${target}/`);
        window.location.pathname = path;
      });
    </script>
  </body>
</html>
